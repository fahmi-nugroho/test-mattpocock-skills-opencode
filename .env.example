# Copy to .env.local and fill in (never commit .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://xyzproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional public fallback for WA deep-links when the settings RPC is
# unreachable (ticket 03 landing stays readable). Admin-managed wa_number
# from settings id=1 is preferred at runtime.
NEXT_PUBLIC_WA_NUMBER=6280000000000
# Server-only (never NEXT_PUBLIC_): used locally to apply supabase/migrations
# (ticket 02 backend: schema/RLS/storage/seed) and backfill data. Never ship to the browser or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Calendar mirror — server-only. Never prefix any of these with
# NEXT_PUBLIC_: the browser must never receive a Google credential.
# The private key may be supplied with escaped \n sequences; the app
# normalises them before signing. See docs/google-calendar-setup.md.
GOOGLE_SERVICE_ACCOUNT_EMAIL=mua-mirror@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nGANTI_DENGAN_KUNCI_ASLI\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=mua-booking@group.calendar.google.com
GOOGLE_CALENDAR_CRON_SECRET=replace-with-a-long-random-secret

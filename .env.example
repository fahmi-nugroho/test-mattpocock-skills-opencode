# Copy to .env.local and fill in (never commit .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://xyzproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (never NEXT_PUBLIC_): used locally to apply supabase/migrations
# (ticket 02 backend: schema/RLS/storage/seed) and backfill data. Never ship to the browser or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
